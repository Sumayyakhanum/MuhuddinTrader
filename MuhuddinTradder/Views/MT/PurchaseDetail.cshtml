@model MTDBMVC.Models.MtPurDtl
@{
    ViewData["Title"] = "Purchase Items";
    var items = ViewBag.Items as List<MTDBMVC.Models.MtItmMst>;
    var detailList = ViewBag.DetailList as List<MTDBMVC.Models.MtPurDtl>;
    var master = ViewBag.Master as MTDBMVC.Models.MtPurMst;
    string invCd = ViewBag.InvoiceId;
}
<link rel="stylesheet" href="~/css/site-custom.css" />

<div class="mt-wrapper">
    <div class="mt-top-bar">
        <div class="mt-page-title" style="border:none;margin:0;">
            Purchase Invoice: @invCd
            @if (master != null && master.InvDt.HasValue)
            {
                <span style="font-size:14px;color:#64748b;font-weight:400;">
                    (@master.InvDt.Value.ToString("dd-MMM-yyyy"))
                </span>
            }
        </div>
        <a class="mt-btn mt-btn-secondary" asp-action="PurchaseDetails">Back to Invoice List</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mt-alert-success">@TempData["Success"]</div>
    }

    <div class="mt-form-card">
        <form asp-action="SavePurchaseDetail" method="post">
            <input type="hidden" name="InvCd" value="@invCd" />
            <div asp-validation-summary="ModelOnly" class="mt-alert-error"></div>

            <div class="mt-form-group">
                <label>Item</label>
                <select name="ItmCd" id="itmCdSelect">
                    <option value="">-- Select Item --</option>
                    @if (items != null)
                    {
                        foreach (var i in items)
                        {
                            <option value="@i.ItmCd">@i.ItmDesc (@i.ItmCd)</option>
                        }
                    }
                </select>
            </div>

            <div class="mt-form-group" id="stockInfoBox" style="display:none;background:#f1f5f9;border-radius:6px;padding:10px 12px;">
                <span>Ab tak Purchase: <strong id="stockPurchased">0</strong></span>
                &nbsp;|&nbsp;
                <span>Ab tak Sale: <strong id="stockSold">0</strong></span>
                &nbsp;|&nbsp;
                <span>Current Stock: <strong id="stockCurrent">0</strong></span>
            </div>

            <div class="mt-form-group">
                <label>Manufacture Date</label>
                <input type="date" name="Dom" />
            </div>

            <div class="mt-form-group">
                <label>Expiry Date</label>
                <input type="date" name="Doe" />
            </div>

            <div class="mt-form-group">
                <label>Quantity</label>
                <input type="number" step="0.01" name="RcvgQty" id="qtyInput" />
            </div>

            <div class="mt-form-group">
                <label>Rate</label>
                <input type="number" step="0.01" name="Rate" id="rateInput" />
            </div>

            <div class="mt-form-group">
                <label>Discount</label>
                <input type="text" inputmode="decimal" name="Disc" id="discInput" value="0" class="mt-no-spinner" />
            </div>

            <div class="mt-form-group">
                <label>Cost (auto calculate hota hai, chahen to badal len)</label>
                <input type="number" step="0.01" name="Cost" id="costInput" />
            </div>

            <div class="mt-form-actions">
                <button type="submit" class="mt-btn">Add / Update Item</button>
            </div>
        </form>
    </div>

    <div class="mt-page-title" style="font-size:16px;">Items in this Invoice</div>

    <div class="mt-table-wrap">
        <table class="mt-table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Rate</th>
                    <th>Discount</th>
                    <th>Cost</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (detailList != null && detailList.Count > 0)
                {
                    foreach (var d in detailList)
                    {
                        var itemName = items != null ? items.FirstOrDefault(x => x.ItmCd == d.ItmCd)?.ItmDesc : d.ItmCd;
                        <tr>
                            <td>@itemName (@d.ItmCd)</td>
                            <td>@d.RcvgQty</td>
                            <td>@d.Rate</td>
                            <td>@d.Disc</td>
                            <td>@d.Cost</td>
                            <td class="mt-actions">
                                <a class="mt-btn mt-btn-sm mt-btn-danger"
                                   asp-action="DeletePurchaseDetail"
                                   asp-route-invCd="@invCd" asp-route-itmCd="@d.ItmCd"
                                   onclick="return confirm('Ye item row delete karni hai?');">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="mt-empty-row">Abhi tak koi item add nahi hua.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // Rate/Qty/Discount change par Cost auto calculate karta hai (aap manually bhi badal saktay hain)
    (function () {
        var qty = document.getElementById('qtyInput');
        var rate = document.getElementById('rateInput');
        var disc = document.getElementById('discInput');
        var cost = document.getElementById('costInput');

        function recalc() {
            var q = parseFloat(qty.value) || 0;
            var r = parseFloat(rate.value) || 0;
            var d = parseFloat(disc.value) || 0;
            cost.value = ((q * r) - d).toFixed(2);
        }

        [qty, rate, disc].forEach(function (el) {
            el.addEventListener('input', recalc);
        });
    })();

    // Item select karte hi us item ki ab tak ki total purchase / sale / current stock dikhao
    (function () {
        var itmSelect = document.getElementById('itmCdSelect');
        var box = document.getElementById('stockInfoBox');

        if (!itmSelect) return;

        itmSelect.addEventListener('change', function () {
            var itmCd = itmSelect.value;
            if (!itmCd) {
                box.style.display = 'none';
                return;
            }

            fetch('@Url.Action("GetItemStock", "MT")?itmCd=' + encodeURIComponent(itmCd))
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    document.getElementById('stockPurchased').textContent = (data.purchased || 0).toFixed(2);
                    document.getElementById('stockSold').textContent = (data.sold || 0).toFixed(2);
                    document.getElementById('stockCurrent').textContent = (data.stock || 0).toFixed(2);
                    box.style.display = 'block';
                })
                .catch(function () { box.style.display = 'none'; });
        });
    })();
</script>
