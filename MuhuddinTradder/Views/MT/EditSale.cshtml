@model MTDBMVC.Models.MtSaleMst
@{
    ViewData["Title"] = "Edit Sale";
    var traders = ViewBag.Traders as List<MTDBMVC.Models.MtTraderMst>;
}
<link rel="stylesheet" href="~/css/site-custom.css" />

<div class="mt-wrapper">
    <div class="mt-top-bar">
        <div class="mt-page-title" style="border:none;margin:0;">Edit Sale - @Model.InvCd</div>
        <a class="mt-btn mt-btn-secondary" asp-action="SaleDetails">Back to List</a>
    </div>

    <div class="mt-form-card">
        <form asp-action="EditSale" method="post">
            <input type="hidden" asp-for="InvCd" />
            <div asp-validation-summary="ModelOnly" class="mt-alert-error"></div>

            <div class="mt-form-group">
                <label>Invoice No.</label>
                <input value="@Model.InvCd" disabled />
            </div>

            <div class="mt-form-group">
                <label>Invoice Date</label>
                <input asp-for="InvDt" type="date" />
            </div>

            <div class="mt-form-group">
                <label>Customer</label>
                <select asp-for="TrdCd">
                    @if (traders != null)
                    {
                        foreach (var t in traders)
                        {
                            <option value="@t.TrdCd">@t.TrdDesc</option>
                        }
                    }
                </select>
            </div>

            <div class="mt-form-actions">
                <button type="submit" class="mt-btn">Update Sale</button>
                <a class="mt-btn mt-btn-secondary" asp-action="SaleDetail" asp-route-invCd="@Model.InvCd">Manage Items</a>
                <a class="mt-btn mt-btn-secondary" asp-action="SaleDetails">Cancel</a>
            </div>
        </form>
    </div>
</div>
