@model MTDBMVC.Models.MtPurMst
@{
    ViewData["Title"] = "New Purchase";
    var traders = ViewBag.Traders as List<MTDBMVC.Models.MtTraderMst>;
}
<link rel="stylesheet" href="~/css/site-custom.css" />

<div class="mt-wrapper">
    <div class="mt-top-bar">
        <div class="mt-page-title" style="border:none;margin:0;">New Purchase Invoice</div>
        <a class="mt-btn mt-btn-secondary" asp-action="PurchaseDetails">View All Purchases</a>
    </div>

    <div class="mt-form-card">
        <form asp-action="SavePurchase" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="mt-alert-error"></div>

            <div class="mt-form-group">
                <label>Invoice No.</label>
                <input asp-for="InvCd" placeholder="Invoice number likhen (e.g. PUR0001)" autocomplete="off" />
                <span asp-validation-for="InvCd" class="mt-alert-error" style="display:block;padding:4px 0;"></span>
            </div>

            <div class="mt-form-group">
                <label>Invoice Date</label>
                <input asp-for="InvDt" type="date" />
            </div>

            <div class="mt-form-group">
                <label>Supplier</label>
                <select asp-for="TrdCd">
                    <option value="">-- Select Supplier --</option>
                    @if (traders != null)
                    {
                        foreach (var t in traders)
                        {
                            <option value="@t.TrdCd">@t.TrdCd - @t.TrdDesc</option>
                        }
                    }
                </select>
                @if (traders == null || traders.Count == 0)
                {
                    <small style="color:#a52422;">Pehle Supplier type ka Trader add karen.</small>
                }
            </div>

            <div class="mt-form-group">
                <label>Received Date (optional)</label>
                <input asp-for="RcvdDt" type="date" />
            </div>

            <div class="mt-form-group">
                <label>Invoice Attachment (bill ki scan / photo, optional)</label>
                <input type="file" name="AttachmentFile" accept=".pdf,.jpg,.jpeg,.png,.webp" onchange="mtPreviewAttachment(this, 'attachmentPreviewBox')" />
                <div id="attachmentPreviewBox" class="mt-attachment-preview" style="display:none;margin-top:8px;">
                    <img id="attachmentPreviewBox-img" src="" alt="Attachment preview" style="max-width:160px;max-height:160px;border:1px solid #e2e8f0;border-radius:6px;object-fit:cover;" />
                    <div id="attachmentPreviewBox-file" style="display:none;color:#334155;font-size:13px;background:#f1f5f9;border-radius:6px;padding:6px 10px;"></div>
                </div>
            </div>

            <div class="mt-form-actions">
                <button type="submit" class="mt-btn">Save &amp; Add Items</button>
                <a class="mt-btn mt-btn-secondary" asp-action="Dashboard">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // File select hote hi (submit se pehle) usi line mein image ka preview dikhata hai.
        // Image nahi hai (jaise PDF) to sirf file ka naam dikhata hai.
        function mtPreviewAttachment(input, boxId) {
            var box = document.getElementById(boxId);
            var img = document.getElementById(boxId + '-img');
            var fileLabel = document.getElementById(boxId + '-file');

            if (!input.files || !input.files[0]) {
                box.style.display = 'none';
                return;
            }

            var file = input.files[0];

            if (file.type && file.type.indexOf('image/') === 0) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                    img.style.display = 'block';
                    fileLabel.style.display = 'none';
                    box.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                img.style.display = 'none';
                fileLabel.style.display = 'block';
                fileLabel.textContent = 'Selected file: ' + file.name;
                box.style.display = 'block';
            }
        }
    </script>
}
