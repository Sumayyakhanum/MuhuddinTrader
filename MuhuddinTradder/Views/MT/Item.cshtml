@model MTDBMVC.Models.MtItmMst
@{
    ViewData["Title"] = "New Item";
    var categories = ViewBag.Categories as List<MTDBMVC.Models.MtItemCate>;
    var units = ViewBag.Units as List<MTDBMVC.Models.MtUnitMst>;
}
<link rel="stylesheet" href="~/css/site-custom.css" />

<div class="mt-wrapper">
    <div class="mt-top-bar">
        <div class="mt-page-title" style="border:none;margin:0;">New Item</div>
        <a class="mt-btn mt-btn-secondary" asp-action="ItemDetails">View All Items</a>
    </div>

    <div class="mt-form-card">
        <form asp-action="SaveItem" method="post">
            <div asp-validation-summary="ModelOnly" class="mt-alert-error"></div>

            <div class="mt-form-group">
                <label>Item Description</label>
                <input asp-for="ItmDesc" placeholder="Item ka naam" />
            </div>

            <div class="mt-form-group">
                <label>Category</label>
                <select asp-for="CatCd">
                    <option value="">-- Select Category --</option>
                    @if (categories != null)
                    {
                        foreach (var c in categories)
                        {
                            <option value="@c.CatCd">@c.CatDesc</option>
                        }
                    }
                </select>
                @if (categories == null || categories.Count == 0)
                {
                    <small style="color:#a52422;">Pehle Category add karen (Dashboard &gt; Categories).</small>
                }
            </div>

            <div class="mt-form-group">
                <label>Unit</label>
                <select asp-for="UnitCd">
                    <option value="">-- Select Unit --</option>
                    @if (units != null)
                    {
                        foreach (var u in units)
                        {
                            <option value="@u.UnitCd">@u.UnitDesc</option>
                        }
                    }
                </select>
                @if (units == null || units.Count == 0)
                {
                    <small style="color:#a52422;">Pehle Unit add karen (Dashboard &gt; Units).</small>
                }
            </div>

            <div class="mt-form-group">
                <label>Shelf Life (days)</label>
                <input asp-for="ItmShelfLife" type="number" placeholder="e.g. 180" />
            </div>

            <div class="mt-form-group">
                <label>Minimum Order Qty (MOQ)</label>
                <input asp-for="ItmMoq" type="number" step="0.01" placeholder="e.g. 10" />
            </div>

            <div class="mt-form-group">
                <label>Status</label>
                <select asp-for="ItmStatus">
                    <option value="A">Active</option>
                    <option value="I">Inactive</option>
                </select>
            </div>

            <div class="mt-form-actions">
                <button type="submit" class="mt-btn">Save Item</button>
                <a class="mt-btn mt-btn-secondary" asp-action="Dashboard">Cancel</a>
            </div>
        </form>
    </div>
</div>
